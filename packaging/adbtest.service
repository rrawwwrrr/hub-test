[Unit]
Description=ADB Test Runner
Documentation=https://github.com/rrawwwrrr/hub-test
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/var/lib/hub-test
EnvironmentFile=/etc/default/hub-test
ExecStart=/usr/local/bin/hub-test --watch --pull
Restart=on-failure
RestartSec=15
TimeoutStopSec=3
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
